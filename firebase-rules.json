{
  "rules": {
    "rooms": {
      ".read": true,
      "$roomCode": {
        ".write": true,
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['name', 'isHost', 'connected'])"
          }
        }
      }
    },
    "typing-maniac": {
      "rankings": {
        ".read": true,
        ".write": true
      }
    },
    "snake": {
      "rankings": {
        ".read": true,
        ".write": true
      }
    }
  }
}
